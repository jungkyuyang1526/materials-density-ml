        ")\n",
        "ax.set_title(\"Density Distribution by Chemical System\")\n",
        "ax.set_xlabel(r\"Density (g cm$^{-3}$)\")\n",
        "ax.set_ylabel(\"Number of Materials\")\n",
        "fig.tight_layout()\n",
        "fig.savefig(FIGURES_DIR / \"density_distribution.png\", dpi=300)\n",
