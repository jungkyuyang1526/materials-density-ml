      "source": [
        "# RUN THIS CELL\n",
        "actual_values = test_target.to_numpy()\n",
        "predicted_values = np.asarray(\n",
        "    selected_test_predictions\n",
        ")\n",
        "\n",
        "axis_min = min(\n",
        "    actual_values.min(), predicted_values.min()\n",
        ")\n",
        "axis_max = max(\n",
        "    actual_values.max(), predicted_values.max()\n",
        ")\n",
        "axis_range = axis_max - axis_min\n",
        "axis_padding = (\n",
