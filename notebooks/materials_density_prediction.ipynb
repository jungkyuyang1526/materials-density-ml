        ")\n",
        "ax.set_xlabel(r\"Actual Density (g cm$^{-3}$)\")\n",
        "ax.set_ylabel(r\"Predicted Density (g cm$^{-3}$)\")\n",
        "fig.tight_layout()\n",
        "fig.savefig(FIGURES_DIR / \"parity_plot.png\", dpi=300)\n",
        "plt.show()\n"
